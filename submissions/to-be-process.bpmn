  <bpmn:collaboration id="Collaboration_0hs1h8p">
    <bpmn:participant id="Participant_1b8iwpp" name="Smart-Recovery portal" processRef="Process_0ltwgdg" />
    <bpmn:group id="Group_0yozh57" />
    <bpmn:textAnnotation id="TextAnnotation_1jpi20w">
      <bpmn:text>evaluate case based on factors: account history, dispute flags, compliance/legal markers, debt age, hardship/vulnerability</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sm85hr">
      <bpmn:text>limit reached on auth retries, or unusual activity</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1rep1lk">
      <bpmn:text>e.g. call agent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_15zgivs">
      <bpmn:text>external payment gateway</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1fy9px2">
      <bpmn:text>if case is eligible for self-serve</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1b9f92g">
      <bpmn:text>MO: reduced admin effort to manage customer details</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06u6jwx">
      <bpmn:text>MO: faster next action, with portal interface</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_13o4ric">
      <bpmn:text>MO: improved follow-up efficiency, relies on automated timers</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0medp3u">
      <bpmn:text>MO: easier reporting, agents will receive consistent info</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_184o0lo">
      <bpmn:text>MO: automated case triage</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_050r04h">
      <bpmn:text>MO: reduced admin effort to handle payment</bpmn:text>
    </bpmn:textAnnotation>
